{% doc %}
  Renders the product variant picker with unavailable option values hidden.
  @param {product} product - Product to render.
  @param {object} section - Product section.
  @param {object} block - Variant picker block.
  @param {variant} current_variant - Selected variant.
  @param {boolean} show_size_chart - Whether to show the size chart.
  @param {string} size_chart_label - Size chart link label.
  @param {page} size_chart_page - Size chart page.
  @param {string} size_chart_type - Size chart display mode.
  @param {string} section_id - Section identifier.
{% enddoc %}
{% render 'snip-product-json', product: product %}
{%- unless product.has_only_default_variant -%}
  {%- if settings.product_variants == 'swatches' -%}
    <div
      class="product__variants-swatches mt4 mb6 no-js-hidden"
      data-hide-variant-picker
      data-section="{{ section.id }}"
      data-section-id="{{ section.id }}"
      data-url="{{ product.url }}"
      data-selected-variant-id="{{ current_variant.id }}"
    >
      {% for option in product.options_with_values %}
        {% render 'swatch-hide-variant',
          option: option,
          current_variant: current_variant,
          product: product,
          show_size_chart: show_size_chart,
          size_chart_label: size_chart_label,
          size_chart_page: size_chart_page,
          size_chart_type: size_chart_type,
          section_id: section_id
        %}
      {% endfor %}
    </div>
  {%- else -%}
    <div
      class="product__variants-select no-js-hidden selector-wrapper"
      data-hide-variant-picker
      data-section="{{ section.id }}"
      data-url="{{ product.url }}"
      data-section-id="{{ section.id }}"
    >
      {% if product.metafields.custom.combined_listing %}
        <div class="product-form__input product-form__input--dropdown">
          {% assign combine_listing = product.metafields.custom.combined_listing.value %}

          <div class="related-product-swatches">
            {% assign priority_tags = 'BRASS CORDING,MONOCHROME,COLORBLOCK,TAPE TRIM,MARIPOSA,FRINGE,PANEL,KNIFE EDGE,EDGE FINISH,SOLID'
              | split: ','
            %}

            {% for related_product in combine_listing %}
              <div class="swatch-item">
                <a
                  href="{{ related_product.url }}"
                  class="swatch {% if related_product.id == product.id %}active{% endif %}"
                >
                  <img
                    src="{{ related_product.featured_image | image_url: width: 200 }}"
                    alt="{{ related_product.title }}"
                    width="200"
                    height="auto"
                  >
                </a>

                {% assign displayed_tag = '' %}

                {% for priority_tag in priority_tags %}
                  {% if related_product.tags contains priority_tag %}
                    {% assign displayed_tag = priority_tag %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% if displayed_tag != '' %}
                  <span class="swatch-label">{{ displayed_tag }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {%- for option in product.options_with_values -%}
        {% liquid
          assign available_values = option.values | where: 'available', true
          assign selected_value = option.values | where: 'selected', true | first
        %}
        {% unless template == 'product.quick' %}
          {% assign option_name = option.name | downcase %}
          {% assign size_swatches = 'size, sizes, talla, taglia, taille, tamanho, grosse' | split: ', ' %}
          {% if show_size_chart and size_swatches contains option_name %}
            {% render 'size-chart',
              label: size_chart_label,
              page: size_chart_page,
              section_id: section_id,
              type: size_chart_type
            %}
          {% endif %}
        {% endunless %}
        <div class="product-form__input product-form__input--dropdown">
          <label
            class="form__label"
            for="Option-{{ section.id }}-{{ forloop.index0 }}"
          >
            {{ option.name }}
          </label>
          <div class="select">
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="js-variant-selector styled-select"
              name="options[{{ option.name | escape }}]"
              data-hide-variant-option
              data-selected-value="{{ option.selected_value | escape }}"
              {% if available_values == empty %}disabled{% endif %}
              form="product-form-{{ section.id }}"
            >
              {% if available_values == empty %}
                <option
                  value=""
                  selected
                  disabled
                  data-position="{{ option.position }}"
                  data-option-value-id="{{ selected_value.id }}"
                  name="{{ option.name | downcase | escape }}"
                >
                  {{ 'products.product.sold_out' | t }}
                </option>
              {% endif %}
              {%- for option_value in available_values -%}
                <option
                  value="{{ option_value | escape }}"
                  {% if option.selected_value == option_value %}
                    selected="selected"
                  {% endif %}
                  data-position="{{ option.position }}"
                  data-option-value-id="{{ option_value.id }}"
                  name="{{ option.name | downcase | escape }}"
                >
                  {{ option_value }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- endunless -%}

<input
  class="formVariantId"
  name=""
  type="hidden"
  value="{{ current_variant.id }}"
>
<style>
  [data-hide-unavailable-variants] .related-product-swatches {
    display: flex;
    gap: 0px;
    flex-wrap: wrap;
    justify-content: left;
    width: 75%; /* controls space between */
  }

  [data-hide-unavailable-variants] .swatch {
    display: flex;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    width: 65%;
    cursor: pointer;
    justify-content: center;
    position: relative;
  }

  [data-hide-unavailable-variants] .swatch img {
    width: 100%;
    height: auto;
    display: block;
  }

  [data-hide-unavailable-variants] .swatch:hover {
      border-color: black
  }

  [data-hide-unavailable-variants] .swatch.active {
    border-color: black;
  }

  [data-hide-unavailable-variants] .swatch-label {
    font-size: 12px;
    letter-spacing: 0.2em;
    white-space: nowrap;
    text-align: center;
  }

  [data-hide-unavailable-variants] .swatch-item {
    flex: 1; /* every item same width */
    max-width: 140px; /* optional cap */

    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
