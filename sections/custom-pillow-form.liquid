      fieldWrapper.setAttribute('aria-hidden', showParallelTrimField ? 'false' : 'true');

      fieldWrapper.querySelectorAll('[data-custom-pillow-field]').forEach((field) => {
        field.disabled = !showParallelTrimField;

        if (!showParallelTrimField) {
          field.value = '';
        }
      });
    });
  };

  const toggleCustomPillowBoxBandFields = (item) => {
    const boxBandRow = item.querySelector('[data-custom-pillow-box-band-row]');
    const boxBandSelect = item.querySelector('[data-custom-pillow-box-band-select]');
    const boxBandFields = item.querySelector('[data-custom-pillow-box-band-fields]');

    if (!boxBandSelect || !boxBandFields) return;

    const boxBandValue = (boxBandSelect.value || '').trim().toLowerCase();
    const showBoxBandRow = !boxBandSelect.disabled;
    const showBoxBandFields = showBoxBandRow && boxBandValue !== '' && boxBandValue !== 'no box band';

    if (boxBandRow) {
      boxBandRow.style.display = showBoxBandRow ? 'grid' : 'none';
      boxBandRow.setAttribute('aria-hidden', showBoxBandRow ? 'false' : 'true');
    }

    boxBandFields.style.display = showBoxBandFields ? 'grid' : 'none';
    boxBandFields.setAttribute('aria-hidden', showBoxBandFields ? 'false' : 'true');

    if (showBoxBandFields) {
      boxBandFields.classList.add('custom-pillow-form__conditional-fields--visible');
    } else {
      boxBandFields.classList.remove('custom-pillow-form__conditional-fields--visible');
    }

    boxBandFields.querySelectorAll('[data-custom-pillow-field]').forEach((field) => {
      field.disabled = !showBoxBandFields;

      if (!showBoxBandFields) {
        field.value = '';
      }
    });
  };

  const getCustomPillowSelectedOptionText = (field) => {
    if (field.tagName !== 'SELECT') return '';

    const selectedOption = field.options[field.selectedIndex];
    return selectedOption?.textContent || field.value || '';
  };

  const getCustomPillowPriceFromText = (text) => {
    const prices = String(text || '').match(/\$[0-9]+(?:\.[0-9]{1,2})?/g) || [];
    return prices.reduce((total, price) => total + Number(price.replace('$', '')), 0);
  };

  const formatCustomPillowPrice = (amount) => {
    return `$${amount.toLocaleString('en-US', {
      minimumFractionDigits: Number.isInteger(amount) ? 0 : 2,
      maximumFractionDigits: 2,
    })}`;
  };

  const customPillowOptionalFieldLabels = new Set([
    'ESTIMATED PRICE',
    'NOTES',
    'SAME SIDED',
    'SIDEMARK',
  ]);

  const getCustomPillowFieldLabel = (field) => {
    const label = field.dataset.fieldLabel || field.closest('.custom-pillow-form__field')?.querySelector('label')?.textContent || 'FIELD';
    return label.trim().replace(/\s+/g, ' ').toUpperCase();
  };

  const getCustomPillowValidationName = (field) => {
    const fieldLabel = getCustomPillowFieldLabel(field);
    const item = field.closest('[data-custom-pillow-item]');
    const itemNumber = item?.querySelector('[data-custom-pillow-item-number]')?.textContent?.trim();

    return itemNumber ? `ITEM ${itemNumber} - ${fieldLabel}` : fieldLabel;
  };

  const shouldValidateCustomPillowField = (field) => {
    if (!field || field.disabled || field.type === 'hidden' || field.type === 'checkbox' || field.type === 'submit') return false;
    if (field.name === 'contact[Sidemark]' || field.name === 'contact[body]') return false;

    return !customPillowOptionalFieldLabels.has(getCustomPillowFieldLabel(field));
  };

  const getCustomPillowValidationFields = (form, scope = form) => {
    const selector = scope === form
      ? '.custom-pillow-form__contact input, [data-custom-pillow-field]'
      : '[data-custom-pillow-field]';

    return Array.from(scope.querySelectorAll(selector));
  };

  const setCustomPillowFieldErrorState = (field, hasError) => {
    const fieldWrapper = field.closest('.custom-pillow-form__field');

    field.classList.toggle('custom-pillow-form__input--error', hasError);
    field.setAttribute('aria-invalid', hasError ? 'true' : 'false');

    if (fieldWrapper) {
      fieldWrapper.classList.toggle('custom-pillow-form__field--error', hasError);
    }
  };

  const syncCustomPillowRequiredFields = (form) => {
    getCustomPillowValidationFields(form).forEach((field) => {
      field.required = shouldValidateCustomPillowField(field);
      field.setCustomValidity('');
      setCustomPillowFieldErrorState(field, false);
    });
  };

  const getCustomPillowFieldError = (field) => {
    if (!shouldValidateCustomPillowField(field)) return '';

    const fieldName = getCustomPillowValidationName(field);

    field.setCustomValidity('');

    if (field.validity.valueMissing) {
      return `PLEASE COMPLETE ${fieldName}.`;
    }

    if (field.validity.typeMismatch) {
      if (field.type === 'email') return `PLEASE ENTER A VALID EMAIL ADDRESS.`;
      if (field.type === 'url') return `PLEASE ENTER A VALID URL FOR ${fieldName}.`;
      return `PLEASE ENTER A VALID VALUE FOR ${fieldName}.`;
    }

    if (field.validity.stepMismatch) {
      if (field.dataset.customPillowWholeNumber === 'true') {
        return `PLEASE ENTER A WHOLE NUMBER FOR ${fieldName}.`;
      }

      return `PLEASE ENTER A VALID VALUE FOR ${fieldName}.`;
    }

    if (field.validity.rangeUnderflow) {
      return `PLEASE ENTER A VALUE OF AT LEAST ${field.min} FOR ${fieldName}.`;
    }

    if (field.validity.rangeOverflow) {
      return `PLEASE ENTER A VALUE OF ${field.max} OR LESS FOR ${fieldName}.`;
    }

    return '';
  };

  const validateCustomPillowForm = (form, showMessage = false, fields = getCustomPillowValidationFields(form)) => {
    const validationError = form.querySelector('[data-custom-pillow-validation-error]');
    const validationErrorText = form.querySelector('[data-custom-pillow-validation-error-text]');
    const fieldStates = fields.map((field) => {
      const message = getCustomPillowFieldError(field);
      field.setCustomValidity(message);
      return { field, message };
    });
    const fieldErrors = fieldStates.filter((fieldError) => fieldError.message);
    const shouldShowMessage = showMessage || (validationError && !validationError.hidden);

    fieldStates.forEach((fieldState) => {
      setCustomPillowFieldErrorState(fieldState.field, shouldShowMessage && fieldState.message !== '');
    });

    if (fieldErrors.length && validationError && validationErrorText && shouldShowMessage) {
      validationErrorText.replaceChildren();

      if (fieldErrors.length === 1) {
        validationErrorText.textContent = fieldErrors[0].message;
      } else {
        const messageIntro = document.createElement('p');
        const fieldList = document.createElement('ul');

        messageIntro.textContent = 'PLEASE COMPLETE THESE FIELDS:';

        fieldErrors.forEach((fieldError) => {
          const fieldListItem = document.createElement('li');
          fieldListItem.textContent = getCustomPillowValidationName(fieldError.field);
          fieldList.appendChild(fieldListItem);
        });

        validationErrorText.append(messageIntro, fieldList);
      }

      validationError.hidden = false;
    } else if (validationError) {
      validationErrorText?.replaceChildren();
      validationError.hidden = true;
    }

    return {
      isValid: fieldErrors.length === 0,
      firstInvalidField: fieldErrors[0]?.field,
    };
  };

  const isCustomPillowDraftEnabled = (form) => {
    return form.dataset.customPillowDraftEnabled === 'true' && form.dataset.customPillowCustomerId;
  };

  const getCustomPillowDraftKey = (form) => {
    return `custom-pillow-form-draft:${form.dataset.customPillowCustomerId}:${window.location.pathname}`;
  };

  const getCustomPillowDraftFormKey = () => {
    return window.location.pathname;
  };

  const getCustomPillowDraftBasePath = (form) => {
    const fallbackPath = '/apps/wishlist-1/custom-pillow-draft';
    const formAction = form.getAttribute('action') || '';

    try {
      const actionUrl = new URL(formAction, window.location.origin);
      return actionUrl.pathname.replace(/\/custom-pillow-form$/, '/custom-pillow-draft') || fallbackPath;
    } catch (error) {
      return fallbackPath;
    }
  };

  const getCustomPillowDraftEndpoint = (form, path = '') => {
    const params = new URLSearchParams({
      form_key: getCustomPillowDraftFormKey(),
    });

    return `${getCustomPillowDraftBasePath(form)}${path}?${params.toString()}`;
  };

  const readCustomPillowLocalDraft = (form) => {
    try {
      return JSON.parse(window.localStorage.getItem(getCustomPillowDraftKey(form)) || 'null');
    } catch (error) {
      window.localStorage.removeItem(getCustomPillowDraftKey(form));
      return null;
    }
  };

  const writeCustomPillowLocalDraft = (form, draftData) => {
    try {
      window.localStorage.setItem(getCustomPillowDraftKey(form), JSON.stringify(draftData));
      return true;
    } catch (error) {
      return false;
    }
  };

  const removeCustomPillowLocalDraft = (form) => {
    window.localStorage.removeItem(getCustomPillowDraftKey(form));
  };

  const fetchCustomPillowServerDraft = async (form) => {
    if (!isCustomPillowDraftEnabled(form)) return null;

    const response = await window.fetch(getCustomPillowDraftEndpoint(form), {
      method: 'GET',
      headers: {
        Accept: 'application/json',
      },
      credentials: 'same-origin',
    });
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data.error || 'Draft could not be loaded.');
    }

    return data.draft || null;
  };

  const saveCustomPillowServerDraft = async (form, draftData) => {
    if (!isCustomPillowDraftEnabled(form)) return null;

    const response = await window.fetch(getCustomPillowDraftEndpoint(form), {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        formKey: getCustomPillowDraftFormKey(),
        draft: draftData,
      }),
    });
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data.error || 'Draft could not be saved.');
    }

    return data.draft || draftData;
  };

  const clearCustomPillowServerDraft = async (form) => {
    if (!isCustomPillowDraftEnabled(form)) return false;

    const response = await window.fetch(getCustomPillowDraftEndpoint(form, '/clear'), {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        formKey: getCustomPillowDraftFormKey(),
      }),
    });
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data.error || 'Draft could not be cleared.');
    }

    return true;
  };

  const showCustomPillowDraftFeedback = (form, message) => {
    const draftFeedback = form.querySelector('[data-custom-pillow-draft-feedback]');
    const draftFeedbackText = form.querySelector('[data-custom-pillow-draft-feedback-text]');
    if (!draftFeedback) return;

    if (draftFeedbackText) {
      draftFeedbackText.textContent = message;
    } else {
      draftFeedback.textContent = message;
    }

    draftFeedback.hidden = false;

    window.clearTimeout(form.customPillowDraftFeedbackTimeout);
    form.customPillowDraftFeedbackTimeout = window.setTimeout(() => {
      draftFeedback.hidden = true;
    }, 3500);
  };

  const resetCustomPillowItemFields = (item) => {
    item.querySelectorAll('input, select, textarea').forEach((field) => {
      field.setCustomValidity?.('');
      field.removeAttribute('aria-invalid');
      field.classList.remove('custom-pillow-form__input--error');
      field.closest('.custom-pillow-form__field')?.classList.remove('custom-pillow-form__field--error');

      if (field.type === 'checkbox') {
        field.checked = false;
        field.value = field.getAttribute('value') || 'YES';
      } else if (field.dataset.fieldLabel === 'QUANTITY') {
        field.value = '1';
      } else if (field.type !== 'hidden') {
        field.value = '';
      }
    });
  };

  const cloneCustomPillowItem = (sourceItem) => {
    const newItem = sourceItem.cloneNode(true);
    resetCustomPillowItemFields(newItem);
    return newItem;
  };

  const findCustomPillowItemField = (item, fieldId) => {
    return Array.from(item.querySelectorAll('[data-custom-pillow-field]')).find((field) => {
      return field.dataset.fieldId === fieldId;
    });
  };

  const setCustomPillowFieldValue = (field, fieldData) => {
    if (!field) return;

    const productTypeDraftValue = String(fieldData.value || '').trim().toUpperCase();
    const fieldValue = field.dataset.fieldId?.includes('customPillowProductType') && (productTypeDraftValue === 'PILLOW' || productTypeDraftValue === 'PILLOW (STANDARD)')
      ? 'PILLOW (STANDARD SIZES)'
      : field.dataset.fieldId?.includes('customPillowProductType') && productTypeDraftValue === 'PILLOW (CUSTOM)'
        ? 'PILLOW (CUSTOM SIZES)'
        : fieldData.value || '';

    if (field.type === 'checkbox') {
      field.checked = Boolean(fieldData.checked);
      field.value = field.getAttribute('value') || fieldValue || 'YES';
      return;
    }

    field.value = fieldValue;
  };

  const getCustomPillowDraftData = (form) => {
    const contactFields = Array.from(form.querySelectorAll('[name="contact[name]"], [name="contact[email]"], [name="contact[Sidemark]"], [name="contact[body]"]')).map((field) => {
      return {
        name: field.name,
        value: field.value || '',
      };
    });
    const items = Array.from(form.querySelectorAll('[data-custom-pillow-item]')).map((item) => {
      return {
        fields: Array.from(item.querySelectorAll('[data-custom-pillow-field]')).filter((field) => {
          return !field.hasAttribute('data-custom-pillow-estimate-input');
        }).map((field) => {
          return {
            fieldId: field.dataset.fieldId,
            value: field.value || '',
            checked: field.type === 'checkbox' ? field.checked : undefined,
          };
        }),
      };
    });

    return {
      savedAt: new Date().toISOString(),
      contactFields,
      items,
    };
  };

  const saveCustomPillowDraft = async (form) => {
    if (!isCustomPillowDraftEnabled(form)) return false;

    updateCustomPillowForm(form);
    const draftData = getCustomPillowDraftData(form);
    const localDraftSaved = writeCustomPillowLocalDraft(form, draftData);

    try {
      const syncedDraft = await saveCustomPillowServerDraft(form, draftData);

      if (syncedDraft) {
        writeCustomPillowLocalDraft(form, syncedDraft);
      }

      showCustomPillowDraftFeedback(form, 'DRAFT SAVED.');
      return true;
    } catch (error) {
      showCustomPillowDraftFeedback(
        form,
        localDraftSaved
          ? 'DRAFT SAVED ON THIS DEVICE. CROSS-DEVICE SYNC FAILED.'
          : 'DRAFT COULD NOT BE SAVED.'
      );
      return localDraftSaved;
    }
  };

  const resetCustomPillowDraftFields = (form) => {
    form.querySelectorAll('[name="contact[name]"], [name="contact[email]"], [name="contact[Sidemark]"], [name="contact[body]"]').forEach((field) => {
      field.value = '';
      field.setCustomValidity?.('');
      field.removeAttribute('aria-invalid');
      field.closest('.custom-pillow-form__field')?.classList.remove('custom-pillow-form__field--error');
    });

    const itemsContainer = form.querySelector('[data-custom-pillow-items]');
    const firstItem = itemsContainer?.querySelector('[data-custom-pillow-item]');

    if (itemsContainer && firstItem) {
      itemsContainer.querySelectorAll('[data-custom-pillow-item]').forEach((item, index) => {
        if (index > 0) item.remove();
      });

      resetCustomPillowItemFields(firstItem);
    }

    updateCustomPillowForm(form);
    validateCustomPillowForm(form);
  };

  const clearCustomPillowDraft = async (form, showMessage = true, resetFields = true) => {
    if (!isCustomPillowDraftEnabled(form)) return;

    removeCustomPillowLocalDraft(form);

    if (resetFields) {
      resetCustomPillowDraftFields(form);
    }

    try {
      await clearCustomPillowServerDraft(form);

      if (showMessage) {
        showCustomPillowDraftFeedback(form, 'DRAFT CLEARED.');
      }
    } catch (error) {
      if (showMessage) {
        showCustomPillowDraftFeedback(form, 'DRAFT CLEARED ON THIS DEVICE. CROSS-DEVICE CLEAR FAILED.');
      }
    }
  };

  const applyCustomPillowDraft = (form, itemsContainer, draft) => {
    if (!isCustomPillowDraftEnabled(form)) return;

    if (!draft?.items?.length) return;

    draft.contactFields?.forEach((fieldData) => {
      const field = Array.from(form.querySelectorAll('[name]')).find((formField) => formField.name === fieldData.name);
      if (field) field.value = fieldData.value || '';
    });

    const firstItem = itemsContainer.querySelector('[data-custom-pillow-item]');
    if (!firstItem) return;

    itemsContainer.querySelectorAll('[data-custom-pillow-item]').forEach((item, index) => {
      if (index > 0) item.remove();
    });

    resetCustomPillowItemFields(firstItem);

    while (itemsContainer.querySelectorAll('[data-custom-pillow-item]').length < draft.items.length) {
      itemsContainer.appendChild(cloneCustomPillowItem(firstItem));
    }

    const restoredItems = Array.from(itemsContainer.querySelectorAll('[data-custom-pillow-item]'));

    draft.items.forEach((itemData, index) => {
      const item = restoredItems[index];
      const productTypeField = itemData.fields.find((fieldData) => {
        return String(fieldData.fieldId || '').includes('customPillowProductType');
      });

      if (productTypeField) {
        setCustomPillowFieldValue(findCustomPillowItemField(item, productTypeField.fieldId), productTypeField);
      }
    });

    updateCustomPillowForm(form);

    draft.items.forEach((itemData, index) => {
      const item = restoredItems[index];

      itemData.fields.forEach((fieldData) => {
        setCustomPillowFieldValue(findCustomPillowItemField(item, fieldData.fieldId), fieldData);
      });
    });

    updateCustomPillowForm(form);

    draft.items.forEach((itemData, index) => {
      const item = restoredItems[index];

      itemData.fields.forEach((fieldData) => {
        setCustomPillowFieldValue(findCustomPillowItemField(item, fieldData.fieldId), fieldData);
      });
    });

    updateCustomPillowForm(form);
    validateCustomPillowForm(form);
  };

  const restoreCustomPillowDraft = async (form, itemsContainer) => {
    if (!isCustomPillowDraftEnabled(form)) return;

    let draft = null;

    try {
      draft = await fetchCustomPillowServerDraft(form);

      if (draft?.items?.length) {
        writeCustomPillowLocalDraft(form, draft);
      }
    } catch (error) {
      draft = readCustomPillowLocalDraft(form);
    }

    if (!draft?.items?.length) {
      draft = readCustomPillowLocalDraft(form);
    }

    if (!draft?.items?.length) return;

    applyCustomPillowDraft(form, itemsContainer, draft);
    showCustomPillowDraftFeedback(form, 'DRAFT LOADED.');
  };

  const updateCustomPillowEstimatedPrice = (item) => {
    const estimateText = item.querySelector('[data-custom-pillow-estimate-text]');
    const estimateInput = item.querySelector('[data-custom-pillow-estimate-input]');
    const productTypeSelect = item.querySelector('[data-custom-pillow-product-type-select]');
    const productTypeValue = (productTypeSelect?.value || '').trim().toLowerCase();
    const quantityInput = item.querySelector('[data-field-label="QUANTITY"]');
    const quantity = Math.max(Number(quantityInput?.value || 1) || 1, 1);
    const basePrice = customPillowBasePrices[productTypeValue] || 0;
    const sizeSelect = item.querySelector('[data-custom-pillow-size-select]');
    const addInsertSelect = item.querySelector('[data-custom-pillow-add-insert-select]');
    const insertTypeSelect = item.querySelector('[data-custom-pillow-insert-type-select]');
    const addInsertValue = (addInsertSelect?.value || '').trim().toLowerCase();
    const insertTypeValue = (insertTypeSelect?.value || '').trim().toLowerCase();
    const isStandardPillow = productTypeValue === 'pillow' || productTypeValue === 'pillow (standard)' || productTypeValue === 'pillow (standard sizes)';
    const isCustomPillow = productTypeValue === 'pillow (custom)' || productTypeValue === 'pillow (custom sizes)';
    const isXlLumbar = productTypeValue === 'xl lumbar' || productTypeValue === 'xl lumbar 14" x 48"';
    const standardIntendedUseSelect = item.querySelector('[data-custom-pillow-standard-intended-use-field] [data-custom-pillow-field]');
    const standardIntendedUseValue = (standardIntendedUseSelect?.value || '').trim().toLowerCase();
    const isOutdoorPillow = (isStandardPillow || isCustomPillow || isXlLumbar) && standardIntendedUseValue === 'outdoor';
    const hasOutdoorInsertEstimate = isOutdoorPillow && ((isStandardPillow || isCustomPillow) ? addInsertValue === 'yes' : isXlLumbar);
    const insertPricesBySize = insertTypeValue === 'feather down'
      ? customPillowFeatherDownInsertPricesBySize
      : customPillowDownAlternativeInsertPricesBySize;
    const insertPrice = isStandardPillow && !isOutdoorPillow && addInsertValue === 'yes'
      && (insertTypeValue === 'feather down' || insertTypeValue === 'down alternative')
      ? insertPricesBySize[sizeSelect?.value] || 0
      : 0;
    const optionPrice = Array.from(item.querySelectorAll('select[data-custom-pillow-field]')).reduce((total, field) => {
      if (field.disabled) return total;
      return total + getCustomPillowPriceFromText(getCustomPillowSelectedOptionText(field));
    }, 0);
    const estimateEach = basePrice + optionPrice + insertPrice;
    const estimateValue = hasOutdoorInsertEstimate
      ? 'PRICE TBD'
      : estimateEach > 0
      ? `${formatCustomPillowPrice(estimateEach)} EACH${quantity > 1 ? ` / ${formatCustomPillowPrice(estimateEach * quantity)} TOTAL` : ''}`
      : 'PRICE TBD';

    if (estimateText) {
      estimateText.textContent = estimateValue;
    }

    if (estimateInput) {
      estimateInput.value = estimateValue;
    }

    return {
      hasEstimate: !hasOutdoorInsertEstimate && estimateEach > 0,
      hasUnknownEstimate: hasOutdoorInsertEstimate,
      total: estimateEach * quantity,
    };
  };

  const updateCustomPillowForm = (form) => {
    const summaryInput = form.querySelector('[data-custom-pillow-summary]');
    const orderEstimateText = form.querySelector('[data-custom-pillow-order-estimate-text]');
    const orderEstimateInput = form.querySelector('[data-custom-pillow-order-estimate-input]');
    const items = Array.from(form.querySelectorAll('[data-custom-pillow-item]'));
    let hasOrderEstimate = false;
    let hasUnknownOrderEstimate = false;
    let orderEstimateTotal = 0;

    items.forEach((item, index) => {
      const itemNumber = index + 1;
      const numberElement = item.querySelector('[data-custom-pillow-item-number]');
      const removeButton = item.querySelector('[data-remove-custom-pillow-item]');
      const emailItemHeading = item.querySelector('[data-custom-pillow-email-item-heading]');
      const productTypeSelect = item.querySelector('[data-custom-pillow-product-type-select]');

      if (numberElement) numberElement.textContent = itemNumber;
      if (removeButton) removeButton.hidden = items.length === 1;
      if (emailItemHeading) {
        emailItemHeading.name = `contact[---------- ITEM ${itemNumber} ----------]`;
        emailItemHeading.value = productTypeSelect?.value || 'NO PRODUCT TYPE SELECTED';
      }

      const hasProductType = toggleCustomPillowProductTypeFields(item);

      if (hasProductType) {
        toggleCustomPillowEdgeFinishFields(item);
        toggleCustomPillowSameSideFields(item);
        toggleCustomPillowTapeTrimFields(item);
        toggleCustomPillowBoxBandFields(item);
      }

      const itemEstimate = updateCustomPillowEstimatedPrice(item);

      if (itemEstimate?.hasUnknownEstimate) {
        hasUnknownOrderEstimate = true;
      }

      if (itemEstimate?.hasEstimate) {
        hasOrderEstimate = true;
        orderEstimateTotal += itemEstimate.total;
      }

      item.querySelectorAll('[data-custom-pillow-field]').forEach((field) => {
        const fieldLabel = field.dataset.fieldLabel || 'Field';
        field.name = `contact[ITEM ${itemNumber} - ${fieldLabel}]`;
        const fieldId = `${field.dataset.fieldId}--${itemNumber}`;
        const label = field.closest('.custom-pillow-form__field')?.querySelector('[data-custom-pillow-label]');

        field.id = fieldId;
        if (label) label.setAttribute('for', fieldId);
      });
    });

    const orderEstimateValue = hasUnknownOrderEstimate
      ? 'PRICE TBD'
      : hasOrderEstimate
      ? formatCustomPillowPrice(orderEstimateTotal)
      : 'PRICE TBD';

    if (orderEstimateText) {
      orderEstimateText.textContent = orderEstimateValue;
    }

    if (orderEstimateInput) {
      orderEstimateInput.value = orderEstimateValue;
    }

    syncCustomPillowRequiredFields(form);

    if (!summaryInput) return;

    summaryInput.value = items.map((item, index) => {
      const details = Array.from(item.querySelectorAll('[data-custom-pillow-field]')).filter((field) => {
        return !field.disabled;
      }).map((field) => {
        if (field.type === 'checkbox') {
          return `${field.dataset.fieldLabel}: ${field.checked ? 'YES' : 'NO'}`;
        }

        return `${field.dataset.fieldLabel}: ${field.value || ''}`;
      });

      return `ITEM ${index + 1}: ${details.join(', ')}`;
    }).join('\n');
  };

  const showCustomPillowSubmissionStatus = (form) => {
    const params = new URLSearchParams(window.location.search);
    const status = params.get('custom_pillow_form');
    const successMessage = form.querySelector('[data-custom-pillow-success]');
    const errorMessage = form.querySelector('[data-custom-pillow-error]');

    if (status === 'success') {
      clearCustomPillowDraft(form, false, false);
    }

    if (successMessage) {
      successMessage.hidden = status !== 'success';

      if (status === 'success') {
        successMessage.setAttribute('tabindex', '-1');
        successMessage.focus({ preventScroll: true });
      }
    }

    if (errorMessage) errorMessage.hidden = status !== 'error';

    return status;
  };

  const initCustomPillowForm = (form) => {
    const itemsContainer = form.querySelector('[data-custom-pillow-items]');
    const addButton = form.querySelector('[data-add-custom-pillow-item]');
    const saveDraftButton = form.querySelector('[data-save-custom-pillow-draft]');
    const clearDraftButton = form.querySelector('[data-clear-custom-pillow-draft]');
    const closeDraftFeedbackButton = form.querySelector('[data-custom-pillow-draft-feedback-close]');

    if (!itemsContainer || !addButton) return;

    form.noValidate = true;

    const successMessage = form.querySelector('[data-custom-pillow-success]');
    const closeSuccessButtons = form.querySelectorAll('[data-custom-pillow-success-close]');

    closeSuccessButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (successMessage) successMessage.hidden = true;
      });
    });

    if (successMessage) {
      successMessage.addEventListener('click', (event) => {
        if (event.target === successMessage) successMessage.hidden = true;
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && successMessage && !successMessage.hidden) {
        successMessage.hidden = true;
      }
    });

    addButton.addEventListener('click', () => {
      const firstItem = itemsContainer.querySelector('[data-custom-pillow-item]');
      if (!firstItem) return;

      updateCustomPillowForm(form);

      const currentItems = Array.from(itemsContainer.querySelectorAll('[data-custom-pillow-item]'));
      const lastItem = currentItems[currentItems.length - 1];
      const validation = validateCustomPillowForm(form, true, getCustomPillowValidationFields(form, lastItem));

      if (!validation.isValid) {
        validation.firstInvalidField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        validation.firstInvalidField?.focus({ preventScroll: true });
        return;
      }

      const newItem = cloneCustomPillowItem(firstItem);

      itemsContainer.appendChild(newItem);
      updateCustomPillowForm(form);
      validateCustomPillowForm(form);
    });

    saveDraftButton?.addEventListener('click', () => {
      saveCustomPillowDraft(form);
    });

    clearDraftButton?.addEventListener('click', () => {
      clearCustomPillowDraft(form);
    });

    closeDraftFeedbackButton?.addEventListener('click', () => {
      const draftFeedback = form.querySelector('[data-custom-pillow-draft-feedback]');
      window.clearTimeout(form.customPillowDraftFeedbackTimeout);
      if (draftFeedback) draftFeedback.hidden = true;
    });

    itemsContainer.addEventListener('click', (event) => {
      const removeButton = event.target.closest('[data-remove-custom-pillow-item]');
      if (!removeButton) return;

      const item = removeButton.closest('[data-custom-pillow-item]');
      if (!item || itemsContainer.querySelectorAll('[data-custom-pillow-item]').length === 1) return;

      item.remove();
      updateCustomPillowForm(form);
      validateCustomPillowForm(form);
    });

    itemsContainer.addEventListener('change', (event) => {
      const conditionalInput = event.target.closest('[data-custom-pillow-product-type-select], [data-custom-pillow-edge-finish-select], [data-custom-pillow-tape-trim-select], [data-custom-pillow-box-band-select], [data-custom-pillow-same-side-checkbox], [data-custom-pillow-add-insert-select]');
      if (!conditionalInput) return;

      const item = conditionalInput.closest('[data-custom-pillow-item]');
      if (!item) return;

      updateCustomPillowForm(form);
      validateCustomPillowForm(form);
    });

    form.addEventListener('input', () => {
      updateCustomPillowForm(form);
      validateCustomPillowForm(form);
    });

    form.addEventListener('change', () => {
      updateCustomPillowForm(form);
      validateCustomPillowForm(form);
    });

    form.addEventListener('submit', (event) => {
      updateCustomPillowForm(form);

      const validation = validateCustomPillowForm(form, true);

      if (!validation.isValid) {
        event.preventDefault();
        validation.firstInvalidField?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        validation.firstInvalidField?.focus({ preventScroll: true });
      }
    });

    updateCustomPillowForm(form);
    const submissionStatus = showCustomPillowSubmissionStatus(form);

    if (submissionStatus !== 'success') {
      restoreCustomPillowDraft(form, itemsContainer);
    }

    validateCustomPillowForm(form);
  };

  const initCustomPillowForms = (container = document) => {
    container.querySelectorAll('.custom-pillow-form').forEach((form) => {
      if (form.dataset.customPillowFormInitialized === 'true') return;

      form.dataset.customPillowFormInitialized = 'true';
      initCustomPillowForm(form);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initCustomPillowForms());
  } else {
    initCustomPillowForms();
  }

  document.addEventListener('shopify:section:load', (event) => {
    initCustomPillowForms(event.target);
  });
{% endjavascript %}

<style>
  .section-{{ section.id }} .custom-pillow-form {
    --custom-pillow-form-width: {{ section.settings.width }}px;
  }
</style>

{% schema %}
{
  "name": "Custom pillow form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CUSTOM PILLOW REQUEST"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SUBMIT REQUEST"
    },
    {
      "type": "range",
      "id": "width",
      "min": 520,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Form width",
      "default": 760
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section spacing",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both"
    }
  ],
  "presets": [
    {
      "name": "Custom pillow form"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
