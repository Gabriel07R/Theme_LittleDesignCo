                data-custom-pillow-tape-trim-select
                data-field-label="TAPE TRIM"
              >
                <option value="">CHOOSE ONE</option>
                <option value="NO TRIM">NO TRIM</option>
                <option value="CENTER TRIM [FRONT] (+$10)">CENTER TRIM [FRONT] (+$10)</option>
                <option value="CENTER TRIM [FRONT &amp; BACK] (+$10)">CENTER TRIM [FRONT &amp; BACK] (+$10)</option>
                <option value="PARALLEL TRIM [FRONT] (+$20)">PARALLEL TRIM [FRONT] (+$20)</option>
                <option value="PARALLEL TRIM [FRONT &amp; BACK] (+$20)">PARALLEL TRIM [FRONT &amp; BACK] (+$20)</option>
              </select>
            </div>
          </div>

          <div
            data-custom-pillow-tape-trim-fields
            class="custom-pillow-form__item-fields custom-pillow-form__conditional-fields"
            style="display: none;"
            aria-hidden="true"
          >
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowTrimName--{{ section.id }}--1">TRIM NAME</label>
              <input
                id="customPillowTrimName--{{ section.id }}--1"
                data-field-id="customPillowTrimName--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="TRIM NAME"
                type="text"
                disabled
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowTrimLink--{{ section.id }}--1">TRIM LINK</label>
              <input
                id="customPillowTrimLink--{{ section.id }}--1"
                data-field-id="customPillowTrimLink--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="TRIM LINK"
                type="url"
                placeholder="https://"
                disabled
              >
            </div>

            <div data-custom-pillow-parallel-trim-field class="custom-pillow-form__field" style="display: none;" aria-hidden="true">
              <label data-custom-pillow-label for="customPillowInsetFromEdge--{{ section.id }}--1">INSET FROM EDGE</label>
              <input
                id="customPillowInsetFromEdge--{{ section.id }}--1"
                data-field-id="customPillowInsetFromEdge--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="INSET FROM EDGE"
                type="number"
                min="0"
                step="0.25"
                inputmode="decimal"
                placeholder="INCHES"
                disabled
              >
            </div>
          </div>

          <div data-custom-pillow-box-band-row class="custom-pillow-form__item-fields">
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowBoxBand--{{ section.id }}--1">BOX BAND</label>
              <select
                id="customPillowBoxBand--{{ section.id }}--1"
                data-field-id="customPillowBoxBand--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-box-band-select
                data-field-label="BOX BAND"
              >
                <option value="">CHOOSE ONE</option>
                <option value="NO BOX BAND">NO BOX BAND</option>
                <option value="BOX BAND SELF (+$25)">BOX BAND SELF (+$25)</option>
                <option value="CONTRAST BOX BAND (+$25)">CONTRAST BOX BAND (+$25)</option>
                <option value="TAPE TRIM AS BOX BAND (+$35)">TAPE TRIM AS BOX BAND (+$35)</option>
              </select>
            </div>
          </div>

          <div
            data-custom-pillow-box-band-fields
            class="custom-pillow-form__item-fields custom-pillow-form__conditional-fields"
            style="display: none;"
            aria-hidden="true"
          >
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowBoxBandFabricName--{{ section.id }}--1">BOX BAND FABRIC NAME & COLORWAY</label>
              <input
                id="customPillowBoxBandFabricName--{{ section.id }}--1"
                data-field-id="customPillowBoxBandFabricName--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="BOX BAND FABRIC NAME & COLORWAY"
                type="text"
                disabled
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowBoxBandFabricLink--{{ section.id }}--1">BOX BAND FABRIC LINK</label>
              <input
                id="customPillowBoxBandFabricLink--{{ section.id }}--1"
                data-field-id="customPillowBoxBandFabricLink--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="BOX BAND FABRIC LINK"
                type="url"
                placeholder="https://"
                disabled
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowBoxBandWidth--{{ section.id }}--1">BOX BAND WIDTH</label>
              <input
                id="customPillowBoxBandWidth--{{ section.id }}--1"
                data-field-id="customPillowBoxBandWidth--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="BOX BAND WIDTH"
                type="number"
                min="0"
                step="0.25"
                inputmode="decimal"
                placeholder="INCHES"
                disabled
              >
            </div>
          </div>

          <div class="custom-pillow-form__field">
            <label data-custom-pillow-label for="customPillowItemSidemark--{{ section.id }}--1">SIDEMARK</label>
            <input
              id="customPillowItemSidemark--{{ section.id }}--1"
              data-field-id="customPillowItemSidemark--{{ section.id }}"
              data-custom-pillow-field
              data-field-label="SIDEMARK"
              type="text"
            >
          </div>

          <div data-custom-pillow-item-notes-field class="custom-pillow-form__field custom-pillow-form__item-notes">
            <label data-custom-pillow-label for="customPillowItemNotes--{{ section.id }}--1">NOTES</label>
            <textarea
              id="customPillowItemNotes--{{ section.id }}--1"
              data-field-id="customPillowItemNotes--{{ section.id }}"
              data-custom-pillow-field
              data-field-label="NOTES"
              placeholder="Any additional changes can be requested here"
              rows="4"
            ></textarea>
          </div>

          <div data-custom-pillow-estimate class="custom-pillow-form__estimate" aria-live="polite">
            <span class="custom-pillow-form__estimate-label">ESTIMATED PRICE</span>
            <strong data-custom-pillow-estimate-text>PRICE TBD</strong>
            <input
              type="hidden"
              id="customPillowEstimatedPrice--{{ section.id }}--1"
              data-field-id="customPillowEstimatedPrice--{{ section.id }}"
              data-custom-pillow-field
              data-custom-pillow-estimate-input
              data-field-label="ESTIMATED PRICE"
              value="PRICE TBD"
            >
          </div>
          </div>
        </div>
      </div>

      <button type="button" data-add-custom-pillow-item class="custom-pillow-form__add secondary button">
        ADD MORE ITEM
      </button>

      {% if customer %}
        <div class="custom-pillow-form__draft-actions">
          <button type="button" data-save-custom-pillow-draft class="secondary button">
            SAVE DRAFT
          </button>
          <button type="button" data-clear-custom-pillow-draft class="button-as-link">
            CLEAR DRAFT
          </button>
        </div>
      {% endif %}

      <div class="custom-pillow-form__field custom-pillow-form__notes">
        <label for="customPillowNotes--{{ section.id }}">ADDITIONAL NOTES</label>
        <textarea id="customPillowNotes--{{ section.id }}" rows="6" name="contact[body]"></textarea>
      </div>

      <div data-custom-pillow-order-estimate class="custom-pillow-form__order-estimate" aria-live="polite">
        <p>*PRICE IS SUBJECT TO CHANGE UPON APPROVAL*</p>
        <div class="custom-pillow-form__estimate custom-pillow-form__estimate--order">
          <span class="custom-pillow-form__estimate-label">ESTIMATED ORDER TOTAL</span>
          <strong data-custom-pillow-order-estimate-text>PRICE TBD</strong>
        </div>
        <input
          type="hidden"
          data-custom-pillow-order-estimate-input
          name="contact[Estimated Order Total]"
          value="PRICE TBD"
        >
      </div>

      <input type="submit" class="secondary button" value="{{ section.settings.button_label | escape }}">
    </form>
  </section>
</div>

{% stylesheet %}
  .custom-pillow-form {
    width: min(100%, var(--custom-pillow-form-width, 760px));
    margin: 0 auto;
  }

  .custom-pillow-form__contact {
    margin-bottom: 24px;
  }

  .custom-pillow-form [data-custom-pillow-validation-error-text] {
    color: #b3261e;
  }

  .custom-pillow-form [data-custom-pillow-validation-error-text] ul {
    margin: 8px 0 0 18px;
    padding: 0;
  }

  .custom-pillow-form [data-custom-pillow-validation-error-text] li {
    margin: 3px 0;
  }

  .custom-pillow-form h3,
  .custom-pillow-form label,
  .custom-pillow-form select,
  .custom-pillow-form button,
  .custom-pillow-form input[type="submit"],
  .custom-pillow-form__bolster-disclaimer,
  .custom-pillow-form .feedback {
    text-transform: uppercase;
  }

  .custom-pillow-form__item {
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: rgba(0, 0, 0, 0.035);
  }

  .custom-pillow-form__item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .custom-pillow-form__item-header h3 {
    margin: 0;
    font-size: 18px;
  }

  .custom-pillow-form__item-fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .custom-pillow-form__product-type-row > .custom-pillow-form__field {
    grid-column: 1 / -1;
  }

  .custom-pillow-form__conditional-fields {
    display: none !important;
  }

  .custom-pillow-form__conditional-fields.custom-pillow-form__conditional-fields--visible {
    display: grid !important;
  }

  .custom-pillow-form__same-side-row {
    display: none;
    margin-bottom: 18px;
  }

  .custom-pillow-form__same-side-row.custom-pillow-form__same-side-row--visible {
    display: block !important;
  }

  .custom-pillow-form__field {
    margin-bottom: 18px;
  }

  .custom-pillow-form__bolster-disclaimer {
    margin: -4px 0 18px;
    font-size: 13px;
    font-style: italic;
  }

  .custom-pillow-form__estimate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    margin: 4px 0 18px;
    border-top: 1px solid var(--dotted-color);
    border-bottom: 1px solid var(--dotted-color);
    text-transform: uppercase;
  }

  .custom-pillow-form__estimate-label {
    font-size: 12px;
    font-weight: 600;
  }

  .custom-pillow-form__estimate strong {
    font-size: 14px;
    text-align: right;
  }

  .custom-pillow-form__order-estimate {
    margin: 22px 0;
  }

  .custom-pillow-form__order-estimate p {
    margin: 0 0 8px;
    font-size: 13px;
    font-style: italic;
    text-transform: uppercase;
  }

  .custom-pillow-form__estimate--order {
    margin-bottom: 0;
  }

  .custom-pillow-form__success-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.45);
  }

  .custom-pillow-form__success-modal[hidden] {
    display: none;
  }

  .custom-pillow-form__success-dialog {
    width: min(100%, 520px);
    padding: 32px;
    border: 1px solid var(--dotted-color);
    background: var(--background, #fff);
    color: var(--text-color, #000);
    text-align: center;
  }

  .custom-pillow-form__success-dialog h3 {
    margin: 0 0 14px;
    font-size: 18px;
    text-transform: uppercase;
  }

  .custom-pillow-form__success-dialog p {
    margin: 0;
    text-transform: none;
  }

  .custom-pillow-form__success-close {
    display: block;
    margin: 0 0 18px auto;
    padding: 0;
    color: #000;
    border: 0;
    background: transparent;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    text-decoration: underline;
    cursor: pointer;
  }

  .custom-pillow-form__field label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0;
  }

  .custom-pillow-form__field-hint {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-left: 6px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 11px;
    line-height: 1;
    cursor: help;
  }

  .custom-pillow-form__field-hint[hidden] {
    display: none;
  }

  .custom-pillow-form__field-hint::after {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    z-index: 2;
    width: max-content;
    max-width: 180px;
    padding: 7px 9px;
    background: #111;
    color: #fff;
    content: attr(data-tooltip);
    font-size: 11px;
    line-height: 1.2;
    opacity: 0;
    pointer-events: none;
    text-transform: none;
    transform: translateX(-50%);
    transition: opacity 120ms ease;
  }

  .custom-pillow-form__field-hint:hover::after,
  .custom-pillow-form__field-hint:focus::after {
    opacity: 1;
  }

  .custom-pillow-form__field input,
  .custom-pillow-form__field select,
  .custom-pillow-form__field textarea {
    width: 100%;
    max-width: none;
    margin-bottom: 0;
  }

  .custom-pillow-form__field--error label {
    color: #b3261e;
  }

  .custom-pillow-form__field--error input,
  .custom-pillow-form__field--error select,
  .custom-pillow-form__field--error textarea {
    border-color: #b3261e !important;
    box-shadow: 0 0 0 1px #b3261e;
  }

  .custom-pillow-form__checkbox-field {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .custom-pillow-form__checkbox-field input {
    width: auto;
  }

  .custom-pillow-form__checkbox-field label {
    margin-bottom: 0;
  }

  .custom-pillow-form__field select {
    height: 44px;
    border: 1px solid var(--dotted-color);
    background: var(--select-arrow-bg) right no-repeat;
    appearance: none;
  }

  .custom-pillow-form__add {
    margin-bottom: 24px;
  }

  .custom-pillow-form__draft-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: -8px 0 24px;
  }

  .custom-pillow-form__draft-feedback {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: min(360px, calc(100vw - 40px));
    padding: 16px 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #111;
    color: #fff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
  }

  .custom-pillow-form__draft-feedback[hidden] {
    display: none;
  }

  .custom-pillow-form__draft-feedback button {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    text-decoration: underline;
    cursor: pointer;
  }

  .custom-pillow-form__notes {
    margin-top: 4px;
  }

  @media screen and (max-width: 740px) {
    .custom-pillow-form__item-fields {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .custom-pillow-form__estimate {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }

    .custom-pillow-form__estimate strong {
      text-align: left;
    }

    .custom-pillow-form__draft-feedback {
      width: calc(100vw - 32px);
      max-width: none;
    }
  }
{% endstylesheet %}

