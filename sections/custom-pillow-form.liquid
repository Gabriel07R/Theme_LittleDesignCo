{%- liquid
  assign section_padding = ''
  if section.settings.section_padding == 'top'
    assign section_padding = 'pb0'
  elsif section.settings.section_padding == 'bottom'
    assign section_padding = 'mt0'
  elsif section.settings.section_padding == 'none'
    assign section_padding = 'mt0 pb0'
  endif
-%}

<div class="global__section custom-pillow-form-section {{ section_padding }}">
  <section
    data-section-loaded="false"
    data-section-type="custom-pillow-form-section"
    class="row section-{{ section.id }}{% if settings.animation != 'none' %} animate {{ settings.animation }}{% endif %}"
    data-section-id="{{ section.id }}"
  >
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% endif %}

    <form
      method="post"
      action="/apps/wishlist-1/custom-pillow-form"
      class="custom-pillow-form span-12 auto"
      data-custom-pillow-form-id="{{ section.id }}"
      data-custom-pillow-draft-enabled="{% if customer %}true{% else %}false{% endif %}"
      {% if customer %}
        data-custom-pillow-customer-id="{{ customer.id }}"
      {% endif %}
    >
      <input type="hidden" name="return_to" value="{{ request.path | escape }}">
      <input type="hidden" name="contact[Form]" value="CUSTOM PILLOW REQUEST">
      <input type="hidden" data-custom-pillow-summary name="contact[Custom Pillow Items]" value="">

      <div
        data-custom-pillow-success
        class="custom-pillow-form__success-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="customPillowSuccessTitle--{{ section.id }}"
        hidden
      >
        <div class="custom-pillow-form__success-dialog">
          <button type="button" data-custom-pillow-success-close class="custom-pillow-form__success-close">
            CLOSE
          </button>
          <h3 id="customPillowSuccessTitle--{{ section.id }}">COM REQUEST RECEIVED</h3>
          <p>Please allow 1-2 business days for our team to review and get back to you with a quote and yardage amounts.</p>
        </div>
      </div>

      <div data-custom-pillow-error class="errorForm feedback" hidden>
        <p>SORRY, YOUR CUSTOM PILLOW REQUEST COULD NOT BE SENT. PLEASE TRY AGAIN.</p>
      </div>

      <div data-custom-pillow-validation-error class="errorForm feedback" hidden aria-live="assertive">
        <div data-custom-pillow-validation-error-text></div>
      </div>

      {% if customer %}
        <div data-custom-pillow-draft-feedback class="custom-pillow-form__draft-feedback" hidden aria-live="polite">
          <span data-custom-pillow-draft-feedback-text></span>
          <button type="button" data-custom-pillow-draft-feedback-close aria-label="Close draft notification">CLOSE</button>
        </div>
      {% endif %}

      <div class="custom-pillow-form__contact grid__wrapper">
        <div class="custom-pillow-form__field span-6 sm-span-12 auto">
          <label for="customPillowName--{{ section.id }}">NAME</label>
          <input id="customPillowName--{{ section.id }}" type="text" name="contact[name]" autocomplete="name">
        </div>

        <div class="custom-pillow-form__field span-6 sm-span-12 auto">
          <label for="customPillowEmail--{{ section.id }}">EMAIL</label>
          <input id="customPillowEmail--{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
        </div>

        <div class="custom-pillow-form__field span-12 auto">
          <label for="customPillowSidemark--{{ section.id }}">SIDEMARK</label>
          <input id="customPillowSidemark--{{ section.id }}" type="text" name="contact[Sidemark]">
        </div>
      </div>

      <div data-custom-pillow-items class="custom-pillow-form__items">
        <div data-custom-pillow-item class="custom-pillow-form__item">
          <div class="custom-pillow-form__item-header">
            <h3>ITEM <span data-custom-pillow-item-number>1</span></h3>
            <button type="button" data-remove-custom-pillow-item class="custom-pillow-form__remove button-as-link" hidden>
              REMOVE
            </button>
          </div>

          <input
            type="hidden"
            data-custom-pillow-email-item-heading
            name="contact[---------- ITEM 1 ----------]"
            value="NO PRODUCT TYPE SELECTED"
          >

          <p
            data-custom-pillow-bolster-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *ALL BOLSTERS INCLUDE A FIRM FOAM INSERT*
          </p>

          <p
            data-custom-pillow-ottoman-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *IF A CUSTOM HEIGHT IS NEEDED PLEASE LEAVE A NOTE*
          </p>

          <p
            data-custom-pillow-ball-pillow-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *GIVEN THE FLEXIBILITY OF THE FABRIC THE BALL PILLOW CAN RANGE FROM 10-12 INCHES IN DIAMETER*
          </p>

          <div class="custom-pillow-form__item-fields custom-pillow-form__product-type-row">
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowProductType--{{ section.id }}--1">PRODUCT TYPE</label>
              <select
                id="customPillowProductType--{{ section.id }}--1"
                data-field-id="customPillowProductType--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-product-type-select
                data-field-label="PRODUCT TYPE"
              >
                <option value="">SELECT PRODUCT TYPE</option>
                <option value="PILLOW (STANDARD SIZES)">PILLOW (STANDARD SIZES)</option>
                <option value="PILLOW (CUSTOM SIZES)">PILLOW (CUSTOM SIZES)</option>
                <option value="BOLSTER">BOLSTER</option>
                <option value="OTTOMAN">OTTOMAN</option>
                <option value="BALL PILLOW">BALL PILLOW</option>
                <option value='XL LUMBAR 14" X 48"'>XL LUMBAR 14" X 48"</option>
                <option value="SKITTLE">SKITTLE</option>
              </select>
            </div>
          </div>

          <div
            data-custom-pillow-product-details
            class="custom-pillow-form__product-details"
            style="display: none;"
            aria-hidden="true"
          >
            <div class="custom-pillow-form__item-fields">
              <div class="custom-pillow-form__field">
                <label data-custom-pillow-label for="customPillowQuantity--{{ section.id }}--1">QUANTITY</label>
                <input
                  id="customPillowQuantity--{{ section.id }}--1"
                  data-field-id="customPillowQuantity--{{ section.id }}"
                  data-custom-pillow-field
                  data-field-label="QUANTITY"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  value="1"
                >
              </div>

              <div
                data-custom-pillow-standard-intended-use-field
                class="custom-pillow-form__field"
                style="display: none;"
                aria-hidden="true"
              >
                <label data-custom-pillow-label for="customPillowStandardIntendedUse--{{ section.id }}--1">INTENDED USE</label>
                <select
                  id="customPillowStandardIntendedUse--{{ section.id }}--1"
                  data-field-id="customPillowStandardIntendedUse--{{ section.id }}"
                  data-custom-pillow-field
                  data-field-label="INTENDED USE"
                  disabled
                >
                  <option value="">SELECT INTENDED USE</option>
                  <option value="INDOOR">INDOOR</option>
                  <option value="OUTDOOR">OUTDOOR</option>
                </select>
              </div>

            <div
              data-custom-pillow-bolster-length-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowBolsterLength--{{ section.id }}--1">LENGTH</label>
              <input
                id="customPillowBolsterLength--{{ section.id }}--1"
                data-field-id="customPillowBolsterLength--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="LENGTH"
                type="number"
                min="18"
                max="52"
                step="1"
                inputmode="numeric"
                placeholder="INCHES"
                disabled
              >
            </div>

            <div
              data-custom-pillow-bolster-intented-use-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowBolsterIntentedUse--{{ section.id }}--1">INTENDED USE</label>
              <select
                id="customPillowBolsterIntentedUse--{{ section.id }}--1"
                data-field-id="customPillowBolsterIntentedUse--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="INTENDED USE"
                disabled
              >
                <option value="">SELECT INTENDED USE</option>
                <option value="INDOOR">INDOOR</option>
                <option value="OUTDOOR">OUTDOOR</option>
              </select>
            </div>

            <div
              data-custom-pillow-ottoman-type-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowOttomanType--{{ section.id }}--1">OTTOMAN TYPE</label>
              <select
                id="customPillowOttomanType--{{ section.id }}--1"
                data-field-id="customPillowOttomanType--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="OTTOMAN TYPE"
                disabled
              >
                <option value="">SELECT OTTOMAN TYPE</option>
                <option value='SKIRTED OTTOMAN 18" L X 18" W X 19" H ($700)'>SKIRTED OTTOMAN 18" L X 18" W X 19" H ($700)</option>
                <option value='TIGHT ROUND 17" D X 19" H ($500)'>TIGHT ROUND 17" D X 19" H ($500)</option>
                <option value='TIGHT SQUARE 18" L X 18" W X 19" H ($700)'>TIGHT SQUARE 18" L X 18" W X 19" H ($700)</option>
              </select>
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label data-custom-pillow-size-label for="customPillowSize--{{ section.id }}--1">SIZE</label>
              <select
                id="customPillowSize--{{ section.id }}--1"
                data-field-id="customPillowSize--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-size-select
                data-field-label="SIZE"
              >
                <option value="">SELECT SIZE</option>
                <option value='20" X 20"'>20" X 20"</option>
                <option value='22" X 22"'>22" X 22"</option>
                <option value='24" X 24"'>24" X 24"</option>
                <option value='26" X 26"'>26" X 26"</option>
                <option value='LITTLE LUMBAR 12" X 18"'>LITTLE LUMBAR 12" X 18"</option>
                <option value='14" X 24"'>14" X 24"</option>
                <option value='14" X 30"'>14" X 30"</option>
                <option value='14" X 36"'>14" X 36"</option>
                <option value='XL LUMBAR 14" X 48"'>XL LUMBAR 14" X 48"</option>
                <option value='15" X 22"'>15" X 22"</option>
                <option value='20" X 26" STANDARD SHAM'>20" X 26" STANDARD SHAM</option>
                <option value='20" X 30" QUEEN SHAM'>20" X 30" QUEEN SHAM</option>
                <option value='20" X 36" KING SHAM'>20" X 36" KING SHAM</option>
              </select>
            </div>

            <div
              data-custom-pillow-custom-height-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowCustomHeight--{{ section.id }}--1">
                HEIGHT
                <span
                  class="custom-pillow-form__field-hint"
                  tabindex="0"
                  aria-label="Only whole numbers"
                  data-tooltip="Only whole numbers"
                >?</span>
              </label>
              <input
                id="customPillowCustomHeight--{{ section.id }}--1"
                data-field-id="customPillowCustomHeight--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-whole-number="true"
                data-field-label="HEIGHT"
                type="number"
                min="1"
                step="1"
                inputmode="numeric"
                placeholder="INCHES"
                disabled
              >
            </div>

            <div
              data-custom-pillow-custom-width-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowCustomWidth--{{ section.id }}--1">
                WIDTH
                <span
                  class="custom-pillow-form__field-hint"
                  tabindex="0"
                  aria-label="Only whole numbers"
                  data-tooltip="Only whole numbers"
                >?</span>
              </label>
              <input
                id="customPillowCustomWidth--{{ section.id }}--1"
                data-field-id="customPillowCustomWidth--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-whole-number="true"
                data-field-label="WIDTH"
                type="number"
                min="1"
                step="1"
                inputmode="numeric"
                placeholder="INCHES"
                disabled
              >
            </div>

            <div data-custom-pillow-edge-finish-field class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowEdgeFinish--{{ section.id }}--1">EDGE FINISH</label>
              <select
                id="customPillowEdgeFinish--{{ section.id }}--1"
                data-field-id="customPillowEdgeFinish--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-edge-finish-select
                data-field-label="EDGE FINISH"
              >
                <option value="">SELECT EDGE FINISH</option>
                <option value="KNIFE EDGE ($65)">KNIFE EDGE ($65)</option>
                <option value="SELF CORD ($90)">SELF CORD ($90)</option>
                <option value="CONTRAST CORD ($90)">CONTRAST CORD ($90)</option>
                <option value="SELF BUTTERFLY ($90)">SELF BUTTERFLY ($90)</option>
                <option value="CONTRAST BUTTERFLY ($90)">CONTRAST BUTTERFLY ($90)</option>
                <option value="FRINGE / TASSEL ($90)">FRINGE / TASSEL ($90)</option>
                <option value="SELF MITER FLANGE ($90)">SELF MITER FLANGE ($90)</option>
                <option value="CONTRAST MITER FLANGE ($90)">CONTRAST MITER FLANGE ($90)</option>
              </select>
            </div>

            <div
              data-custom-pillow-add-insert-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowAddInsert--{{ section.id }}--1">
                ADD INSERT
                <span
                  data-custom-pillow-custom-insert-hint
                  class="custom-pillow-form__field-hint"
                  tabindex="0"
                  aria-label="Please allow additional 2-3 weeks for custom inserts"
                  data-tooltip="Please allow additional 2-3 weeks for custom inserts"
                  hidden
                >?</span>
              </label>
              <select
                id="customPillowAddInsert--{{ section.id }}--1"
                data-field-id="customPillowAddInsert--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-add-insert-select
                data-field-label="ADD INSERT"
                disabled
              >
                <option value="">SELECT OPTION</option>
                <option value="NO">NO</option>
                <option value="YES">YES</option>
              </select>
            </div>

            <div
              data-custom-pillow-insert-type-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowInsertType--{{ section.id }}--1">INSERT TYPE</label>
              <select
                id="customPillowInsertType--{{ section.id }}--1"
                data-field-id="customPillowInsertType--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-insert-type-select
                data-field-label="INSERT TYPE"
                disabled
              >
                <option value="">SELECT INSERT TYPE</option>
                <option value="FEATHER DOWN">FEATHER DOWN</option>
                <option value="DOWN ALTERNATIVE">DOWN ALTERNATIVE</option>
              </select>
            </div>
          </div>

          <p
            data-custom-pillow-skittle-knife-edge-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *KNIFE EDGE WILL INCLUDE A POLY DOWN INSERT*
          </p>

          <p
            data-custom-pillow-skittle-box-band-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *BOX BAND WILL INCLUDE A FIRM FOAM INSERT*
          </p>

          <p
            data-custom-pillow-xl-lumbar-disclaimer
            class="custom-pillow-form__bolster-disclaimer"
            style="display: none;"
            aria-hidden="true"
          >
            *THE XL LUMBAR INCLUDES AN DOWN ALTERNATIVE INSERT*
          </p>

          <div class="custom-pillow-form__item-fields">
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowMainFabricName--{{ section.id }}--1">FABRIC NAME & COLORWAY</label>
              <input
                id="customPillowMainFabricName--{{ section.id }}--1"
                data-field-id="customPillowMainFabricName--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="FABRIC NAME & COLORWAY"
                type="text"
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowFaceFabricLink--{{ section.id }}--1">FABRIC LINK</label>
              <input
                id="customPillowFaceFabricLink--{{ section.id }}--1"
                data-field-id="customPillowFaceFabricLink--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="FABRIC LINK"
                type="url"
                placeholder="https://"
              >
            </div>
          </div>

          <div class="custom-pillow-form__item-fields">
            <div
              data-custom-pillow-ottoman-trimming-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowOttomanTrimming--{{ section.id }}--1">TRIMMING</label>
              <select
                id="customPillowOttomanTrimming--{{ section.id }}--1"
                data-field-id="customPillowOttomanTrimming--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="TRIMMING"
                disabled
              >
                <option value="">SELECT TRIMMING</option>
                <option value="NO BULLION">NO BULLION</option>
                <option value="BULLION">BULLION</option>
              </select>
            </div>
          </div>

          <div class="custom-pillow-form__item-fields">
            <div
              data-custom-pillow-ottoman-trimming-fabric-name-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowOttomanTrimmingFabricName--{{ section.id }}--1">TRIMMING FABRIC NAME & COLORWAY</label>
              <input
                id="customPillowOttomanTrimmingFabricName--{{ section.id }}--1"
                data-field-id="customPillowOttomanTrimmingFabricName--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="TRIMMING FABRIC NAME & COLORWAY"
                type="text"
                disabled
              >
            </div>

            <div
              data-custom-pillow-ottoman-trimming-fabric-link-field
              class="custom-pillow-form__field"
              style="display: none;"
              aria-hidden="true"
            >
              <label data-custom-pillow-label for="customPillowOttomanTrimmingFabricLink--{{ section.id }}--1">TRIMMING FABRIC LINK</label>
              <input
                id="customPillowOttomanTrimmingFabricLink--{{ section.id }}--1"
                data-field-id="customPillowOttomanTrimmingFabricLink--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="TRIMMING FABRIC LINK"
                type="url"
                placeholder="https://"
                disabled
              >
            </div>
          </div>

          <div
            data-custom-pillow-same-side-wrapper
            class="custom-pillow-form__same-side-row"
            style="display: none;"
            aria-hidden="true"
          >
            <div class="custom-pillow-form__field custom-pillow-form__checkbox-field">
              <input
                id="customPillowSameSide--{{ section.id }}--1"
                data-field-id="customPillowSameSide--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-same-side-checkbox
                data-field-label="SAME SIDED"
                type="checkbox"
                value="YES"
                disabled
              >
              <label data-custom-pillow-label for="customPillowSameSide--{{ section.id }}--1">SAME SIDED</label>
            </div>
          </div>

          <div data-custom-pillow-reverse-fabric-fields class="custom-pillow-form__item-fields">
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label data-custom-pillow-reverse-fabric-name-label for="customPillowReverseFabricName--{{ section.id }}--1">REVERSE FABRIC NAME & COLORWAY</label>
              <input
                id="customPillowReverseFabricName--{{ section.id }}--1"
                data-field-id="customPillowReverseFabricName--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-reverse-fabric-name-field
                data-field-label="REVERSE FABRIC NAME & COLORWAY"
                type="text"
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label data-custom-pillow-reverse-fabric-link-label for="customPillowReverseFabricLink--{{ section.id }}--1">REVERSE FABRIC LINK</label>
              <input
                id="customPillowReverseFabricLink--{{ section.id }}--1"
                data-field-id="customPillowReverseFabricLink--{{ section.id }}"
                data-custom-pillow-field
                data-custom-pillow-reverse-fabric-link-field
                data-field-label="REVERSE FABRIC LINK"
                type="url"
                placeholder="https://"
              >
            </div>
          </div>

          <div
            data-custom-pillow-edge-finish-fields
            class="custom-pillow-form__item-fields custom-pillow-form__conditional-fields"
            style="display: none;"
            aria-hidden="true"
          >
            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowEdgeFinishFabricMaterial--{{ section.id }}--1">EDGE FINISH FABRIC/MATERIAL</label>
              <input
                id="customPillowEdgeFinishFabricMaterial--{{ section.id }}--1"
                data-field-id="customPillowEdgeFinishFabricMaterial--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="EDGE FINISH FABRIC/MATERIAL"
                type="text"
                disabled
              >
            </div>

            <div class="custom-pillow-form__field">
              <label data-custom-pillow-label for="customPillowEdgeFinishFabricMaterialLink--{{ section.id }}--1">EDGE FINISH FABRIC/MATERIAL LINK</label>
              <input
                id="customPillowEdgeFinishFabricMaterialLink--{{ section.id }}--1"
                data-field-id="customPillowEdgeFinishFabricMaterialLink--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="EDGE FINISH FABRIC/MATERIAL LINK"
                type="url"
                placeholder="https://"
                disabled
              >
            </div>

            <div data-custom-pillow-ruffle-length-field class="custom-pillow-form__field" style="display: none;" aria-hidden="true">
              <label data-custom-pillow-label for="customPillowRuffleWidth--{{ section.id }}--1">RUFFLE WIDTH</label>
              <select
                id="customPillowRuffleWidth--{{ section.id }}--1"
                data-field-id="customPillowRuffleWidth--{{ section.id }}"
                data-custom-pillow-field
                data-field-label="RUFFLE WIDTH"
                disabled
              >
