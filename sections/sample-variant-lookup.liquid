{%- liquid
  assign sample_label = 'Sample 4" X 4"'
  assign alternate_sample_label = '4" X 4" Sample'
  assign fabric_swatch_label = 'Fabric Swatch 4" X 4"'
  assign sample_label_downcase = sample_label | downcase
  assign alternate_sample_label_downcase = alternate_sample_label | downcase
  assign fabric_swatch_label_downcase = fabric_swatch_label | downcase
  assign sample_variant_id = ''
  assign color_option_index = ''
  assign color_swatch_options = settings.swatch_option_names | downcase | replace: ' ,', ',' | replace: ', ', ',' | split: ','
  assign product_title_downcase = product.title | downcase

  for option in product.options
    assign option_downcase = option | downcase | strip
    if color_swatch_options contains option_downcase and color_option_index == ''
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

{%- paginate product.variants by 50 -%}
  {%- liquid
    assign rendered_sample_options = ''

    for variant in product.variants
      assign is_sample_variant = false

      if variant.available
        for option_value in variant.options
          assign option_value_downcase = option_value | downcase | strip
          if option_value_downcase == sample_label_downcase or option_value_downcase == alternate_sample_label_downcase or option_value_downcase == fabric_swatch_label_downcase or option_value_downcase contains sample_label_downcase or option_value_downcase contains alternate_sample_label_downcase or option_value_downcase contains fabric_swatch_label_downcase
            assign is_sample_variant = true
            break
          endif
        endfor
      endif

      if is_sample_variant
        assign sample_variant_id = variant.id
        break
      endif
    endfor
  -%}

  {%- capture sample_options_markup -%}
    {%- for variant in product.variants -%}
      {%- liquid
        assign is_sample_variant = false

        if variant.available
          for option_value in variant.options
            assign option_value_downcase = option_value | downcase | strip
            if option_value_downcase == sample_label_downcase or option_value_downcase == alternate_sample_label_downcase or option_value_downcase == fabric_swatch_label_downcase or option_value_downcase contains sample_label_downcase or option_value_downcase contains alternate_sample_label_downcase or option_value_downcase contains fabric_swatch_label_downcase
              assign is_sample_variant = true
              break
            endif
          endfor
        endif

        if is_sample_variant and sample_variant_id == ''
          assign sample_variant_id = variant.id
        endif

        assign sample_option_label = variant.title
        if color_option_index != ''
          assign sample_option_label = variant.options[color_option_index]
        endif
        assign sample_color_label = sample_option_label | strip
        assign sample_label_parts = sample_color_label | split: ' / '
        assign sample_label_parts_size = sample_label_parts | size

        if sample_label_parts_size > 1
          assign color_part_index = sample_label_parts_size | minus: 1
          assign trailing_part_downcase = sample_label_parts[color_part_index] | strip | downcase

          if trailing_part_downcase contains 'piece' or trailing_part_downcase contains 'parallel' or trailing_part_downcase contains 'centered'
            assign color_part_index = color_part_index | minus: 1
          endif

          assign sample_color_label = sample_label_parts[color_part_index] | strip
        endif

        assign sample_color_label = sample_color_label | replace: 'Rosé Pink', 'Rose Pink' | strip
        assign sample_color_label_raw_downcase = sample_color_label | downcase
        unless sample_color_label_raw_downcase == 'no trim'
          assign sample_color_label = sample_color_label | remove: ' Trim' | remove: ' TRIM' | remove: ' trim' | strip
        endunless
        assign sample_image_label = sample_color_label | remove: 'BACKORDER ' | remove: 'Backorder ' | remove: 'backorder ' | strip
        assign sample_color_label_downcase = sample_color_label | downcase
        assign sample_option_key = '|' | append: sample_color_label_downcase | append: '|'
        assign image_prefix = 'CL_'
        if product_title_downcase contains 'outdoor'
          assign image_prefix = 'OD_'
        elsif product_title_downcase contains 'tape trim'
          assign image_prefix = 'TT_'
        elsif product_title_downcase contains 'greek trim'
          assign image_prefix = 'GT_'
        elsif product_title_downcase contains 'trim'
          assign image_prefix = 'GT_'
        endif
        assign image_name = sample_image_label | replace: ' ', '_' | prepend: image_prefix | append: '.png'
        assign image_url = image_name | file_url
        assign bg_image_rule = ''
        assign swatch_class = 'product-sample-option__swatch'
        if sample_color_label_downcase == 'self' and product.featured_image != blank
          assign image_url = product.featured_image | image_url: width: 160
          assign bg_image_rule = 'background-image: url(' | append: image_url | append: ');'
          assign swatch_class = swatch_class | append: ' product-sample-option__swatch--self'
        elsif sample_color_label_raw_downcase == 'no trim'
          if variant.image != blank
            assign image_url = variant.image | image_url: width: 160
            assign bg_image_rule = 'background-image: url(' | append: image_url | append: ');'
            assign swatch_class = swatch_class | append: ' product-sample-option__swatch--self product-sample-option__swatch--no-trim'
          endif
        elsif settings.color_swatch_style == 'custom-image' and image_url != blank
          assign bg_image_rule = 'background-image: url(' | append: image_url | append: ');'
        endif
      -%}

      {%- if is_sample_variant -%}
        {%- unless rendered_sample_options contains sample_option_key -%}
          <form class="product-sample-option-form" action="/cart/add" method="post" data-sample-option-key="{{ sample_color_label_downcase | escape }}">
            <input class="formVariantId" type="hidden" name="items[0][id]" value="{{ variant.id }}">
            <input class="formQty" type="hidden" name="items[0][quantity]" value="1">
            <div class="note note-success js-added-msg" style="display: none">
              <strong>{{ 'products.product.added' | t }}</strong>
            </div>
            <div class="note note-error js-error-msg" style="display: none">
              <strong>{{ 'cart.general.cart_error' | t }}</strong> {{ 'cart.general.update_qty_error' | t }}
            </div>
            <button
              type="submit"
              class="product-sample-option AddtoCart js-ajax-submit"
              name="button"
              value="{{ sample_color_label | escape }}"
              data-quick-add
              data-sample-cart-notification="Fabric Swatch added to cart"
              data-colorway-tooltip="{{ sample_color_label | escape }}"
              aria-label="Add {{ sample_color_label | escape }} sample for {{ product.title | escape }} to cart"
            >
              <span
                class="{{ swatch_class }}"
                style="{{ bg_image_rule }}"
                aria-hidden="true"
              ></span>
              <span class="visually-hidden">{{ sample_color_label }}</span>
            </button>
          </form>
          {%- assign rendered_sample_options = rendered_sample_options | append: sample_option_key -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div
    data-sample-variant-lookup
    data-sample-variant-id="{{ sample_variant_id }}"
    data-current-page="{{ paginate.current_page }}"
    data-pages="{{ paginate.pages }}"
  >
    <div data-sample-variant-options>
      {{ sample_options_markup }}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Sample variant lookup",
  "settings": []
}
{% endschema %}
